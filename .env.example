AGENT_ID=
SITE_ID=
CLOUD_URL=
OYI_EDGE_AGENT_TOKEN=
# The Backend binds this token to AGENT_ID + SITE_ID through OYI_EDGE_AGENT_IDENTITIES.
# Legacy shared-token acceptance is an explicit, temporary Backend compatibility flag.

CAMERA_IP=
ONVIF_PORT=8080
ONVIF_USER=
ONVIF_PASS=

EDGE_REGISTER_PATH=/edge/agent/register
EDGE_HEARTBEAT_PATH=/edge/agent/heartbeat
EDGE_DISCOVERY_PUSH_PATH=/edge/discovery/push
EDGE_CONFIG_PATH=/edge/agent/config

HEARTBEAT_INTERVAL_MS=30000
DISCOVERY_INTERVAL_MS=120000
CONFIG_PULL_INTERVAL_MS=180000
QUEUE_FLUSH_INTERVAL_MS=5000
REQUEST_TIMEOUT_MS=10000
RETRY_BASE_MS=2000
RETRY_MAX_MS=60000
LOCAL_QUEUE_PATH=./data/outbox.json
HEALTH_PORT=9090
GO2RTC_API_URL=http://127.0.0.1:1984
LEGACY_MODE=false

CAMERA_REGISTRY_PATH=
CAMERA_REGISTRY_URL=
CAMERA_AI_INTERVAL_MS=15000
CAMERA_AI_MAX_CAMERAS=12
YOLO_BRIDGE_URL=

# Per-camera credentials are named by credential_ref, for example:
# EDGE_CREDENTIAL_FRONT_GATE_USER=
# EDGE_CREDENTIAL_FRONT_GATE_PASS=
