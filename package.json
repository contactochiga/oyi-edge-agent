{
  "name": "oyi-edge-agent",
  "version": "1.0.0",
  "description": "Oyi Edge Agent local building runtime",
  "main": "agent.js",
  "scripts": {
    "start": "node agent.js",
    "check": "node scripts/check-repo.js",
  "lint": "node scripts/lint-repo.js",
  "build": "node scripts/build-edge-assets.js",
  "security:secrets": "node scripts/check-secrets.js",
  "validate:release": "node scripts/validate-release.js",
    "test": "npm run check",
    "edge:go2rtc:dry-run": "node scripts/generate-go2rtc-config.js --dry-run",
    "edge:go2rtc:config": "node scripts/generate-go2rtc-config.js",
    "edge:camera": "node agent.js",
    "edge:camera-ai": "node scripts/camera-ai-processor.js",
    "edge:camera-ai:dry-run": "node scripts/camera-ai-processor.js --dry-run --once",
    "edge:camera-ai:once": "node scripts/camera-ai-processor.js --dry-run --once",
    "edge:camera:dry-run": "node scripts/check-camera-runtime-readiness.js",
    "edge:health": "node scripts/check-camera-runtime-readiness.js",
    "tier1:smoke": "node scripts/smoke-tier1-foundations.js",
    "edge:bench:camera:dry-run": "node scripts/bench-camera-protocol-phase1.js --dry-run",
    "edge:setup": "node scripts/setup-camera-edge.js"
  },
  "keywords": [],
